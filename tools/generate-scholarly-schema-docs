#!/usr/bin/env bash
set -euo pipefail

# Thin wrapper: invokes latexml-oxide's
# `tools/generate-scholarly-schema-docs` against this repo's
# `schema/html5/scholarly-ltx.rnc`.
#
# Per-module narratives flow in from `## comments` at the head of each
# RNC file via trang + tools/genschema; no separate metadata file is
# needed.
#
# Override LATEXML_OXIDE_TOOLS to point at a different oxide checkout.

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
oxide_tools="${LATEXML_OXIDE_TOOLS:-/home/deyan/git/latexml-oxide/tools}"
output_dir="${1:-$repo_root/build/docs/scholarly-schema}"

oxide_script="$oxide_tools/generate-scholarly-schema-docs"
if [[ ! -x "$oxide_script" ]]; then
  echo "error: oxide schema-doc script not found at $oxide_script" >&2
  echo "set LATEXML_OXIDE_TOOLS or pass an absolute path" >&2
  exit 1
fi

"$oxide_script" \
  --schema "$repo_root/schema/html5/scholarly-ltx.rnc" \
  --output "$output_dir" \
  --title  "Scholarly LaTeXML HTML Schema" \
  --author "validator"
