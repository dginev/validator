# LaTeXML document schema - flattened single-file form.
#
# Vendored from latexml-oxide resources/RelaxNG/LaTeXML.rng
# (https://github.com/dginev/latexml-oxide @ 1a97514349): simplified
# with jing so the urn:x-LaTeXML includes (11 modules + the SVG 1.1
# suite) collapse into one self-contained grammar, then converted to
# compact syntax so the service serves all presets uniformly as .rnc
# (the resolver dispatches the compact-syntax reader on that suffix).
#
# Regenerate after upstream schema changes with:
#   cd latexml-oxide/resources
#   jing -s -C LaTeXML.catalog RelaxNG/LaTeXML.rng > LaTeXML-flat.rng
#   trang LaTeXML-flat.rng latexml.rnc

default namespace = "http://dlmf.nist.gov/LaTeXML"
namespace local = ""
namespace ns1 = "http://www.w3.org/1999/xhtml"
namespace ns2 = "http://www.w3.org/ns/wai-aria"
namespace ns3 = "http://www.w3.org/1999/xlink"
namespace ns4 = "http://www.w3.org/2000/svg"

start = document
document =
  element document {
    attribute ns2:activedescendant { text }?,
    attribute ns2:atomic { text }?,
    attribute ns2:autocomplete { text }?,
    attribute ns2:braillelabel { text }?,
    attribute ns2:brailleroledescription { text }?,
    attribute ns2:busy { text }?,
    attribute ns2:checked { text }?,
    attribute ns2:colcount { text }?,
    attribute ns2:colindex { text }?,
    attribute ns2:colindextext { text }?,
    attribute ns2:colspan { text }?,
    attribute ns2:controls { text }?,
    attribute ns2:current { text }?,
    attribute ns2:describedby { text }?,
    attribute ns2:description { text }?,
    attribute ns2:details { text }?,
    attribute ns2:disabled { text }?,
    attribute ns2:dropeffectDeprecated { text }?,
    attribute ns2:errormessage { text }?,
    attribute ns2:expanded { text }?,
    attribute ns2:flowto { text }?,
    attribute ns2:grabbedDeprecated { text }?,
    attribute ns2:haspopup { text }?,
    attribute ns2:hidden { text }?,
    attribute ns2:invalid { text }?,
    attribute ns2:keyshortcuts { text }?,
    attribute ns2:label { text }?,
    attribute ns2:labelledby { text }?,
    attribute ns2:level { text }?,
    attribute ns2:live { text }?,
    attribute ns2:modal { text }?,
    attribute ns2:multiline { text }?,
    attribute ns2:multiselectable { text }?,
    attribute ns2:orientation { text }?,
    attribute ns2:owns { text }?,
    attribute ns2:placeholder { text }?,
    attribute ns2:posinset { text }?,
    attribute ns2:pressed { text }?,
    attribute ns2:readonly { text }?,
    attribute ns2:relevant { text }?,
    attribute ns2:required { text }?,
    attribute ns2:role { text }?,
    attribute ns2:roledescription { text }?,
    attribute ns2:rowcount { text }?,
    attribute ns2:rowindex { text }?,
    attribute ns2:rowindextext { text }?,
    attribute ns2:rowspan { text }?,
    attribute ns2:selected { text }?,
    attribute ns2:setsize { text }?,
    attribute ns2:sort { text }?,
    attribute ns2:valuemax { text }?,
    attribute ns2:valuemin { text }?,
    attribute ns2:valuenow { text }?,
    attribute ns2:valuetext { text }?,
    attribute * - (local:* | xml:* | ns2:*) { text }*,
    attribute class { xsd:NMTOKENS }?,
    attribute cssstyle { text }?,
    attribute vocab { text }?,
    attribute prefix { text }?,
    attribute about { text }?,
    attribute aboutlabelref { text }?,
    attribute aboutidref { text }?,
    attribute resource { text }?,
    attribute resourcelabelref { text }?,
    attribute resourceidref { text }?,
    attribute property { text }?,
    attribute rel { text }?,
    attribute rev { text }?,
    attribute typeof { text }?,
    attribute datatype { text }?,
    attribute content { text }?,
    attribute xml:lang { text }?,
    attribute xml:id { xsd:ID }?,
    attribute fragid { text }?,
    attribute inlist { text }?,
    attribute labels { text }?,
    attribute backgroundcolor { text }?,
    attribute framed { "rectangle" | "underline" | text }?,
    attribute framecolor { text }?,
    attribute rdf-prefixes { text }?,
    (subtitle
     | date
     | abstract
     | acknowledgements
     | keywords
     | classification
     | tags?
     | title
     | toctitle
     | creator
     | note
     | declare
     | indexmark
     | glossarydefinition
     | rdf
     | resource
     | navigation
     | titlepage)+,
    ((para
      | logical-block
      | theorem
      | proof
      | figure
      | table
      | float
      | pagination
      | rule
      | TOC
      | note
      | declare
      | indexmark
      | glossarydefinition
      | rdf
      | resource
      | navigation)*
     | paragraph
     | subsubsection
     | subsection
     | section
     | chapter
     | part
     | slide
     | slidesequence
     | sidebar
     | sectional-block
     | bibliography
     | appendix
     | index
     | glossary
     | acknowledgements
     | para
     | logical-block
     | theorem
     | proof
     | figure
     | table
     | float
     | pagination
     | rule
     | TOC
     | note
     | declare
     | indexmark
     | glossarydefinition
     | rdf
     | resource
     | navigation)+
  }
