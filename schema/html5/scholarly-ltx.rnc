datatypes w = "http://whattf.org/datatype-draft"
default namespace = "http://www.w3.org/1999/xhtml"

# #####################################################################
#   LaTeXML scholarly HTML profile                                    #
# #####################################################################

## LaTeXML serializes a document as a page shell containing one article
## and an optional generated footer.  The definitions below keep that
## shell distinct from the document-level publication model so validation
## errors name the intent that failed instead of only the concrete HTML
## element that happened to carry it.  Two page shapes exist: the LaTeXML
## page shell (raw output and ar5iv-hosted pages, which add fixed chrome
## inside the same shell), and the arXiv-hosted scaffold.

	ltx.content.start =
		( ltx.page.body | ltx.arxiv.body )

include "scholarly-ltx-model.rnc"
include "scholarly-ltx-classes.rnc"
include "scholarly-ltx-inline.rnc"
include "scholarly-ltx-scaffold.rnc"
include "scholarly-ltx-structure.rnc"
include "scholarly-ltx-blocks.rnc"
include "scholarly-ltx-floats.rnc"
