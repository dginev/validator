# #####################################################################
## Inline Content

## Class contributions (see scholarly-ltx-model.rnc).  Each member is
## annotated with the LaTeXML XML element it renders.
	ltx.Inline.class |=
		( ltx.span.elem        # ltx:text (and inline span renditions)
		| ltx.author.span.elem # creator/contact metadata spans
		| ltx.item.tag.elem    # ltx:tag (caption and item labels)
		| ltx.anchor.elem      # ltx:ref, ltx:anchor, ltx:bibref
		| ltx.emphasis.elem    # ltx:emph
		| ltx.cite.elem        # ltx:cite
		| ltx.glossaryref.elem # ltx:glossaryref
		| ltx.sup.elem         # ltx:sup
		| ltx.sub.elem         # ltx:sub
		| ltx.math.elem        # ltx:Math
		)
	ltx.Misc.inline.class |=
		( ltx.image.elem       # ltx:graphics
		| ltx.linebreak.elem   # ltx:break
		| ltx.error.elem       # ltx:ERROR
		| svg                  # ltx:svg
		)
	## The same Misc renditions are context-free: they appear unchanged in
	## block contexts (img directly inside div.ltx_para, br inside figure).
	ltx.Misc.block.class |=
		( ltx.image.elem
		| ltx.linebreak.elem
		| ltx.error.elem
		| svg
		)
	ltx.Meta.class |=
		( ltx.note.elem        # ltx:note
		| ltx.rdf.elem )       # ltx:rdf

## Inline Span: prose-level text spans (ltx:text and kin)
	ltx.span.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.span }

## Author Metadata Spans: creator names, contact lines, and the
## separators emitted around author lists
	ltx.author.span.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.span.author }

## Link or Cross Reference.  Exactly two anchor shapes leave the
## transform: hyperlinks (ltx:ref with a target, always href, with the
## ltx_ref class except for the raw mailto links emitted around contact
## email addresses), and ltx:anchor, an old-style fragment anchor with a
## legacy name attribute alongside id and no href -- obsolete in HTML5,
## but deliberate upstream output.  A target-less ltx:ref is demoted to
## span.ltx_ref, never to a classless or href-less a.
	ltx.anchor.elem =
		( element a { ltx.Inline.model & ltx.anchor.href.attrs & ltx.class.a? }
		| element a { ltx.Inline.model & ltx.attrs.no-class & ltx.class.anchor
		            & attribute name { text } }
		)

## Emphasis
	ltx.emphasis.elem =
		element em { ltx.Inline.model & em.attrs }

## Citation
	ltx.cite.elem =
		element cite { ltx.Inline.model & ltx.attrs.no-class & ltx.class.cite }

## Glossary Reference: acronym/glossary expansions from ltx:glossaryref;
## the HTML transform picks abbr when the short form is shown, span otherwise
	ltx.glossaryref.elem =
		( element abbr { ltx.Inline.model & ltx.attrs.no-class & ltx.class.glossaryref }
		| element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.glossaryref }
		)

## Superscript
	ltx.sup.elem =
		element sup { ltx.Inline.model & ltx.attrs.no-class & ltx.class.sup }

## Subscript
	ltx.sub.elem =
		element sub { ltx.Inline.model & ltx.attrs.no-class & ltx.class.sub }

## Note: ltx:note is Meta.class -- valid in every shared model, mirroring
## the XML schema where Meta.class appears in Inline, Block, Para, and
## Flow models alike.  The transform (LaTeXML-meta-xhtml.xsl) synthesizes
## a fixed scaffold around the note body: a sup.ltx_note_mark, then
## span.ltx_note_outer holding span.ltx_note_content, which repeats the
## mark, names the note role for non-footnotes (span.ltx_note_type), and
## then carries the note body inline.
	ltx.note.elem =
		element span { ltx.attrs.no-class & ltx.class.note
		             & ( text,
		                 ltx.note.mark.elem,
		                 text,
		                 ltx.note.outer.elem,
		                 text )
		             }
	ltx.note.mark.elem =
		element sup { ltx.Inline.model & ltx.attrs.no-class & ltx.class.note.mark }
	ltx.note.outer.elem =
		element span { ltx.attrs.no-class & ltx.class.note.outer
		             & ( text, ltx.note.content.elem, text )
		             }
	ltx.note.content.elem =
		element span { ltx.attrs.no-class & ltx.class.note.content
		             & ( text,
		                 ltx.note.mark.elem,
		                 text,
		                 ltx.note.type.elem?,
		                 ltx.Inline.model )
		             }
	ltx.note.type.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.note.type }

## RDF Metadata Container: ltx:rdf is Meta.class -- an invisible (typically
## display:none) carrier of an RDFa triple.  It is emitted from hyperref pdf
## metadata (\pdfauthor -> dcterms:creator, \pdftitle -> dcterms:title, ...),
## resolved \lxRDF triples, or \addbibresource-style annotations.  The
## transform (LaTeXML-meta-xhtml.xsl) renders it as div in block context and
## span inline; the body is usually empty but may carry Flow content via the
## optional \lxRDF[content] argument.  The RDFa attributes (about, property,
## content, ...) ride in through \patternref{ltx.attrs.no-class}.
	ltx.rdf.elem =
		( element div  { ltx.Flow.model   & ltx.attrs.no-class & ltx.class.rdf }
		| element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.rdf }
		)

## Inline Image: ltx:graphics renders as img for bitmaps, or as an
## object embed when the graphic is converted to SVG
	ltx.image.elem =
		( ltx.img.elem | ltx.object.elem )
	ltx.img.elem =
		element img { img.inner & ltx.image.attrs & ltx.class.img? }
	ltx.object.elem =
		element object { ltx.object.inner & ltx.object.attrs & ltx.class.img }
	ltx.object.attrs =
		( ltx.attrs.no-class
		& object.attrs.data
		& object.attrs.type?
		& object.attrs.height?
		& object.attrs.width?
		)
	ltx.object.inner =
		( ltx.Inline.model )

## Conversion Error: ltx:ERROR (Misc.class) -- the engine's rendering of
## an unrecoverable conversion problem, e.g. an undefined control
## sequence shown as visible text.  Accepted as faithful LaTeXML output;
## quality gates that want to reject such documents should check for the
## ltx_ERROR token separately.
	ltx.error.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.error }

## Line Break
	ltx.linebreak.elem =
		element br { br.inner & ltx.attrs.no-class & ltx.class.break }

## Math Formula: MathML presentation/content handled by the MathML schema
	ltx.math.elem =
		( math )
