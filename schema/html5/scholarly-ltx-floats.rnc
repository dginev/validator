# #####################################################################
## Floats, Equations, and Tables

## Class contributions (see scholarly-ltx-model.rnc).
	ltx.Para.class |=
		( ltx.theorem.elem         # ltx:theorem, ltx:proof
		| ltx.figure.elem          # ltx:figure, ltx:table, ltx:float
		)
	ltx.Block.class |=
		( ltx.equation.table.elem  # ltx:equation, ltx:equationgroup
		| ltx.itemized.list.elem   # ltx:itemize
		| ltx.enumerated.list.elem # ltx:enumerate
		| ltx.description.list.elem # ltx:description
		)
	ltx.Misc.block.class |=
		( ltx.tabular.elem         # ltx:tabular (block rendition)
		| ltx.transform.outer.elem # transformed ltx:inline-block wrapper
		)

## Theorem-like Block: ltx:theorem / ltx:proof
## (theorem_model = tags?, title?, Para.model)
	ltx.theorem.elem =
		element div { ltx.theorem.inner & ltx.attrs.no-class & ltx.class.theorem }
	ltx.theorem.inner =
		( text,
		  ltx.theorem.title.elem?,
		  ltx.Para.model
		)
	ltx.theorem.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		)

## Bibliography: BackMatter — referenced from the document model, not a
## member of the shared classes
	ltx.bibliography.elem =
		element section { ltx.bibliography.inner & ltx.attrs.no-class & ltx.class.bibliography }
	ltx.bibliography.inner =
		( text,
		  ltx.bibliography.title.elem?,
		  text,
		  ltx.bibliography.list.elem?,
		  text
		)
	ltx.bibliography.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.frontmatter }
		)
	ltx.bibliography.list.elem =
		element ul { ltx.bibliography.list.inner & ltx.attrs.no-class & ltx.class.biblist }
	ltx.bibliography.list.inner =
		( text,
		  ltx.bibliography.item.elem*,
		  text
		)
	ltx.bibliography.item.elem =
		element li { ltx.bibliography.item.inner & ltx.attrs.no-class & ltx.class.item }
	ltx.bibliography.item.inner =
		( text,
		  ( ltx.item.tag.elem
		  | ltx.bibblock.elem
		  | ltx.Inline.class
		  | ltx.Misc.inline.class
		  | ltx.Meta.class
		  | ltx.paragraph.line.elem
		  )*,
		  text
		)

## Bibliography Block: ltx:bibblock — Inline.model in the XML schema,
## which includes Misc.class; the transform emits the block rendition
## (table.ltx_tabular) for tabular material inside the bibblock span,
## so the table is deliberately admitted despite the span host.
	ltx.bibblock.elem =
		element span { ltx.bibblock.inner & ltx.attrs.no-class & ltx.class.bibblock }
	ltx.class.bibblock =
		attribute class { list { "ltx_bibblock", ltx.class.inline.extra* } }
	ltx.bibblock.inner =
		( text
		& ( ltx.Inline.class
		  | ltx.Misc.inline.class
		  | ltx.Meta.class
		  | ltx.tabular.elem
		  )*
		)

## Index: BackMatter, generated by postprocessing from indexmark
## occurrences (index.body.class = Para.model | indexlist;
## indexentry_model = indexphrase, indexrefs?, indexlist?)
	ltx.index.elem =
		element section { ltx.index.inner & ltx.attrs.no-class & ltx.class.index }
	ltx.class.index =
		attribute class { list { "ltx_index", ltx.class.extra* } }
	ltx.index.inner =
		( text,
		  ltx.section.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.index.list.elem
		  )*,
		  text
		)
	ltx.index.list.elem =
		element ul { ltx.index.list.inner & ltx.attrs.no-class & ltx.class.indexlist }
	ltx.class.indexlist =
		attribute class { list { "ltx_indexlist", ltx.class.extra* } }
	ltx.index.list.inner =
		( text,
		  ltx.index.entry.elem*,
		  text
		)
	ltx.index.entry.elem =
		element li { ltx.index.entry.inner & ltx.attrs.no-class & ltx.class.indexentry }
	ltx.class.indexentry =
		attribute class { list { "ltx_indexentry", ltx.class.extra* } }
	ltx.index.entry.inner =
		( text,
		  ltx.index.phrase.elem,
		  text,
		  ltx.index.refs.elem?,
		  text,
		  ltx.index.list.elem?,
		  text
		)
	ltx.index.phrase.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.indexphrase }
	ltx.class.indexphrase =
		attribute class { list { "ltx_indexphrase", ltx.class.inline.extra* } }
	ltx.index.refs.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.indexrefs }
	ltx.class.indexrefs =
		attribute class { list { "ltx_indexrefs", ltx.class.inline.extra* } }

## Float: ltx:figure / ltx:table / ltx:float
## (figure_model = (tags? | figure | table | float | Block.model | Caption.class)*;
## inline material appears directly via minipage serialization, so the
## payload admits Inline.class as a documented deviation)
	ltx.figure.elem =
		element figure { ltx.figure.inner & ltx.attrs.no-class & ltx.class.figure }
	ltx.figure.inner =
		( text,
		  ( ltx.caption.elem
		  | ltx.figure.elem
		  | ltx.figure.body
		  )*,
		  text
		)
	ltx.figure.body =
		( ltx.Block.class
		| ltx.Misc.block.class
		| ltx.Misc.inline.class
		| ltx.Inline.class
		| ltx.Meta.class
		| ltx.figure.flex.elem
		| ltx.listing.line.elem
		)

## Figure Panel: generated flex grids used for algorithms and multi-panel figures
	ltx.figure.flex.elem =
		element div { ltx.figure.flex.inner & ltx.attrs.no-class & ltx.class.figure.flex }
	ltx.class.figure.flex =
		attribute class { list { "ltx_flex_figure", ltx.class.extra* } }
	ltx.figure.flex.inner =
		( text,
		  ( ltx.figure.flex.cell.elem
		  | ltx.figure.flex.break.elem
		  | ltx.listing.line.elem
		  | ltx.block.rule.elem
		  )*,
		  text
		)
	ltx.figure.flex.cell.elem =
		element div { ltx.figure.flex.cell.inner & ltx.attrs.no-class & ltx.class.figure.flex.cell }
	ltx.class.figure.flex.cell =
		attribute class { list { "ltx_flex_cell", ltx.class.extra* } }
	ltx.figure.flex.cell.inner =
		( text,
		  ltx.figure.body*,
		  text
		)
	ltx.figure.flex.break.elem =
		element div { empty & ltx.attrs.no-class & ltx.class.figure.flex.break }
	ltx.class.figure.flex.break =
		attribute class { list { "ltx_flex_break", ltx.class.extra* } }

## Transformed Table Wrapper: LaTeXML wraps scaled table material in CSS transforms.
## The inner wrapper is hard-coded as span in the upstream XSLT even when it
## carries block content (e.g. a rotated minipage rendered as figure), so the
## span content model deliberately admits figures despite the HTML spec.
	ltx.transform.outer.elem =
		element div { ltx.transform.outer.inner & ltx.attrs.no-class & ltx.class.transform.outer }
	ltx.class.transform.outer =
		attribute class { list { "ltx_inline-block", ltx.class.extra* } }
	ltx.transform.outer.inner =
		( text,
		  ltx.transform.inner.elem?,
		  text
		)
	ltx.transform.inner.elem =
		element span { ltx.transform.inner.inner & ltx.attrs.no-class & ltx.class.transform.inner }
	ltx.class.transform.inner =
		attribute class { list { "ltx_transformed_inner", ltx.class.extra* } }
	ltx.transform.inner.inner =
		( text,
		  ( ltx.tabular.elem
		  | ltx.equation.table.elem
		  | ltx.figure.elem
		  | ltx.Inline.class
		  | ltx.Misc.inline.class
		  | ltx.Meta.class
		  )*,
		  text
		)

## Caption
	ltx.caption.elem =
		element figcaption { ltx.Inline.model & ltx.attrs.no-class & ltx.class.caption }

## Display Equation Table: projection scaffolding — the transform lays
## display equations out as a table of alignment pads, formula cells, and
## equation-number cells.  Kept hand-rolled; not part of the shared models.
	ltx.equation.table.elem =
		element table { ltx.equation.table.inner & ltx.attrs.no-class & ltx.class.equation.table }
	ltx.equation.table.inner =
		( text,
		  ltx.equation.rowgroup.elem+,
		  text
		)

## Display Equation Row Group: equations are emitted in a table body
	ltx.equation.rowgroup.elem =
		element tbody { ltx.equation.rowgroup.inner & ltx.attrs.no-class & ltx.class.tbody? }
	ltx.equation.rowgroup.inner =
		( text,
		  ltx.equation.row.elem+,
		  text
		)

## Display Equation Row: alignment pads, formula cell, optional equation number
	ltx.equation.row.elem =
		element tr { ltx.equation.row.inner & ltx.attrs.no-class & ltx.class.equation.row }
	ltx.equation.row.inner =
		( text,
		  ltx.equation.cell.elem*,
		  text
		)

## Display Equation Cell: formula, padding, alignment, or equation number cell
	ltx.equation.cell.elem =
		element td { ltx.equation.number.cell.inner & ltx.table.cell.attrs & ltx.class.equation.cell }
	ltx.equation.number.cell.inner =
		( text,
		  ( ltx.item.tag.elem
		  | ltx.Inline.class
		  | ltx.Misc.inline.class
		  | ltx.Meta.class
		  | ltx.paragraph.line.elem
		  )*,
		  text
		)

## Inline Tabular: in inline context the transform serializes ltx:tabular
## with span stand-ins for table/thead/tbody/tfoot/tr/td, same classes
	ltx.Misc.inline.class |=
		( ltx.inline.tabular.elem )   # ltx:tabular (inline rendition)
	ltx.inline.tabular.elem =
		element span { ltx.inline.tabular.inner & ltx.attrs.no-class & ltx.class.tabular }
	ltx.inline.tabular.inner =
		( text,
		  ltx.inline.table.rowgroup.elem*,
		  text
		)
	ltx.inline.table.rowgroup.elem =
		element span { ltx.inline.table.rowgroup.inner & ltx.attrs.no-class & ( ltx.class.thead | ltx.class.tbody | ltx.class.tfoot ) }
	ltx.inline.table.rowgroup.inner =
		( text,
		  ltx.inline.table.row.elem*,
		  text
		)
	ltx.inline.table.row.elem =
		element span { ltx.inline.table.row.inner & ltx.attrs.no-class & ltx.class.tr }
	ltx.inline.table.row.inner =
		( text,
		  ltx.inline.table.cell.elem*,
		  text
		)
	ltx.inline.table.cell.elem =
		element span { ltx.inline.table.cell.inner & ltx.attrs.no-class & ltx.class.td }
	ltx.inline.table.cell.inner =
		( ltx.Inline.model )

## Table Cell
	ltx.table.cell.elem =
		element td { ltx.table.cell.inner & ltx.table.cell.attrs & ltx.class.td }
	ltx.table.header.cell.elem =
		element th { ltx.table.cell.inner & ltx.table.cell.attrs & ltx.class.td }
	ltx.table.cell.inner =
		( ltx.Flow.model )

## Tabular: ltx:tabular (block rendition)
	ltx.tabular.elem =
		element table { ltx.tabular.inner & ltx.attrs.no-class & ltx.class.tabular }
	ltx.tabular.inner =
		( text,
		  ltx.table.caption.elem?,
		  text,
		  ltx.table.rowgroup.elem+,
		  text
		)
	ltx.table.caption.elem =
		element caption { ltx.Inline.model & ltx.attrs.no-class & ltx.class.caption }

## Table Row Group.  tabular_model in the XML schema admits rows directly
## ((thead | tfoot | tbody | tr)*); when the transform emits bare rows the
## HTML parser inserts an implicit class-less tbody, so the tbody class
## token is optional.
	ltx.table.rowgroup.elem =
		( element thead { ltx.table.rowgroup.inner & ltx.attrs.no-class & ltx.class.thead }
		| element tbody { ltx.table.rowgroup.inner & ltx.attrs.no-class & ltx.class.tbody? }
		| element tfoot { ltx.table.rowgroup.inner & ltx.attrs.no-class & ltx.class.tfoot }
		)
	ltx.table.rowgroup.inner =
		( text,
		  ltx.table.row.elem*,
		  text
		)

## Table Row
	ltx.table.row.elem =
		element tr { ltx.table.row.inner & ltx.attrs.no-class & ltx.class.tr }
	ltx.table.row.inner =
		( text,
		  ( ltx.table.cell.elem | ltx.table.header.cell.elem )*,
		  text
		)

# #####################################################################
## Lists

## Itemized List: ltx:itemize
	ltx.itemized.list.elem =
		element ul { ltx.list.inner & ltx.attrs.no-class & ltx.class.itemize }

## Enumerated List: ltx:enumerate
	ltx.enumerated.list.elem =
		element ol { ltx.list.inner & ltx.attrs.no-class & ltx.class.enumerate }

	ltx.list.inner =
		( text,
		  ltx.list.item.elem*,
		  text
		)

## List Item: ltx:item (item_model = tags?, Para.model)
	ltx.list.item.elem =
		element li { ltx.list.item.inner & ltx.attrs.no-class & ltx.class.item }
	ltx.list.item.inner =
		( text,
		  ltx.item.tag.elem?,
		  ltx.Para.model
		)

## Description List: ltx:description
	ltx.description.list.elem =
		element dl { ltx.description.list.inner & ltx.attrs.no-class & ltx.class.description }
	ltx.description.list.inner =
		( text,
		  ( ltx.description.term.elem, text, ltx.description.body.elem, text )*
		)
	ltx.description.term.elem =
		element dt { ltx.description.term.inner & ltx.attrs.no-class & ltx.class.item }
	ltx.description.term.inner =
		( ltx.Inline.model )
	ltx.description.body.elem =
		element dd { ltx.description.body.inner & ltx.attrs.no-class & ltx.class.item }
	ltx.description.body.inner =
		( text,
		  ltx.Para.model
		)

## Item Tag: visible label/bullet emitted outside native list numbering
	ltx.item.tag.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.tag }
