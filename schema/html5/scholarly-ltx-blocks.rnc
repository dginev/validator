# #####################################################################
## Block-Level Publication Content

## Class contributions (see scholarly-ltx-model.rnc).
	ltx.Block.class |=
		( ltx.paragraph.line.elem  # ltx:p
		| ltx.quote.elem           # ltx:quote
		| ltx.block.elem           # ltx:block
		| ltx.listing.elem         # ltx:listing
		| ltx.pagination.elem      # ltx:pagination
		)
	ltx.Para.class |=
		( ltx.paragraph.elem       # ltx:para
		| ltx.logical-block.elem   # ltx:logical-block
		| ltx.pagination.elem      # ltx:pagination (member of both classes)
		| ltx.block.rule.elem      # ltx:rule
		)
	ltx.Misc.inline.class |=
		( ltx.block.rule.elem )    # ltx:rule (Misc.class membership)
	ltx.Misc.block.class |=
		( ltx.block.rule.elem )

## Paragraph Wrapper: ltx:para -- a logical paragraph whose content is
## the Block model (para_model = Block.model)
	ltx.paragraph.elem =
		element div { ltx.Block.model & ltx.attrs.no-class & ltx.class.para }

## Paragraph Line: ltx:p -- actual prose, Inline model
	ltx.paragraph.line.elem =
		element p { ltx.Inline.model & ltx.attrs.no-class & ltx.class.p }

## Generic Block: ltx:block -- CSS block fragments produced by bindings.
## Deviation from block_model = Block.model: the transform serializes
## inline material directly inside these divs, so the content is Flow,
## plus listing lines observed outside listings.
	ltx.block.elem =
		element div { ltx.block.inner & ltx.attrs.no-class & ltx.class.block }
	ltx.block.inner =
		( text
		& ( ltx.Inline.class
		  | ltx.Block.class
		  | ltx.Misc.inline.class
		  | ltx.Misc.block.class
		  | ltx.Meta.class
		  | ltx.listing.line.elem
		  )*
		)

## Logical Block: ltx:logical-block typesets its contents as paragraphs
## (logical-block_model = Para.model)
	ltx.logical-block.elem =
		element div { ltx.Para.model & ltx.attrs.no-class & ltx.class.logical-block }

## Pagination Marker: explicit page break marker (Block and Para classes)
	ltx.pagination.elem =
		element div { ltx.pagination.inner & ltx.attrs.no-class & ltx.class.pagination }
	ltx.pagination.inner =
		( empty )

## Quotation Block: ltx:quote (quote_model = Block.model)
	ltx.quote.elem =
		element blockquote { ltx.Block.model & ltx.attrs.no-class & ltx.class.quote }
	ltx.class.quote =
		attribute class { list { "ltx_quote", ltx.class.extra* } }

## Listing Block: source-code listings preserve token classes from listings/minted
	ltx.listing.elem =
		element div { ltx.listing.inner & ltx.attrs.no-class & ltx.class.listing }
	ltx.class.listing =
		attribute class { list { "ltx_listing", ltx.class.listing.extra* } }
	ltx.listing.inner =
		( text,
		  ltx.listing.data.elem?,
		  text,
		  ltx.listing.line.elem*,
		  text
		)
	ltx.listing.data.elem =
		element div { ltx.listing.data.inner & ltx.attrs.no-class-no-id & ltx.class.listing.data }
	ltx.class.listing.data =
		attribute class { list { "ltx_listing_data", ltx.class.extra* } }
	ltx.listing.data.inner =
		( text
		& ltx.anchor.elem*
		)
	ltx.listing.line.elem =
		element div { ltx.listing.line.inner & ltx.attrs.no-class & ltx.class.listing.line }
	ltx.class.listing.line =
		attribute class { list { "ltx_listingline", ltx.class.extra* } }
	ltx.listing.line.inner =
		( ltx.Inline.model )

## Standalone Rule: ltx:rule (\code{Para.class | Misc.class}) -- horizontal rules
## emitted as styled spans in both block and inline contexts
	ltx.block.rule.elem =
		element span { ltx.Inline.model & ltx.attrs.no-class & ltx.class.rule }
	ltx.class.rule =
		attribute class { list { "ltx_rule", ltx.class.extra* } }
