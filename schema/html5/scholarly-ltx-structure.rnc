# #####################################################################
## Document Structure

## Scholarly Document: article emitted from a LaTeX source.
## Mirrors document_model: front matter (with Meta.class interspersed,
## e.g. MNRAS pubyear/pagerange notes), then body units at any sectional
## level, plus BackMatter.
	ltx.document.elem =
		element article { ltx.document.inner & ltx.document.attrs }
	ltx.document.attrs =
		( ltx.attrs.no-class & ltx.class.document )
	ltx.document.inner =
		( text,
		  ( ltx.document.front.elem | ltx.Meta.class )*,
		  text,
		  ( ltx.document.body.class | ltx.backmatter.elem )*,
		  text
		)
	ltx.document.body.class =
		( ltx.Para.class
		| ltx.Meta.class
		| ltx.chapter.elem
		| ltx.section.elem
		| ltx.subsection.elem
		| ltx.subsubsection.elem
		| ltx.sectional.paragraph.elem
		| ltx.subparagraph.elem
		| ltx.appendix.elem
		)
	ltx.backmatter.elem =
		( ltx.bibliography.elem
		| ltx.index.elem
		)

## Document Front Matter: title, authors, dates, abstract, or class-specific header
	ltx.document.front.elem =
		( ltx.document.title.elem
		| ltx.author.list.elem
		| ltx.date.list.elem
		| ltx.abstract.elem
		| ltx.frontmatter.block.elem
		| ltx.cv.header.elem
		)

## Document Title
	ltx.document.title.elem =
		element h1 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.document }

## Author List
	ltx.author.list.elem =
		element div { ltx.author.list.inner & ltx.attrs.no-class & ltx.class.authors }
	ltx.author.list.inner =
		( text,
		  ( ltx.creator.elem
		  | ltx.author.span.elem
		  | ltx.note.elem
		  | ltx.span.elem
		  )*,
		  text
		)

## Creator: person or institutional contributor
	ltx.creator.elem =
		element span { ltx.Inline.model & ltx.creator.attrs }
	ltx.creator.attrs =
		( ltx.attrs.no-class & ltx.class.creator )

## Date List
	ltx.date.list.elem =
		element div { ltx.Inline.model & ltx.attrs.no-class & ltx.class.dates }

## Abstract: abstract_model = Block.model
	ltx.abstract.elem =
		element div { ltx.abstract.inner & ltx.attrs.no-class & ltx.class.abstract }
	ltx.abstract.inner =
		( text,
		  ltx.abstract.title.elem?,
		  ltx.Block.model
		)
## The abstract title is exactly h6: the transform hard-codes the rank
## rather than deriving it from sectional depth.
	ltx.abstract.title.elem =
		( element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.abstract }
		)
## Frontmatter blocks: keywords, classification, and acknowledgements,
## each pairing its container class with the matching heading kind.
## Frontmatter-block titles are exactly h6: the transform hard-codes the
## rank rather than deriving it from sectional depth.
	ltx.frontmatter.block.elem =
		( element div { ltx.frontmatter.block.inner.keywords & ltx.attrs.no-class & ltx.class.keywords }
		| element div { ltx.frontmatter.block.inner.classification & ltx.attrs.no-class & ltx.class.classification }
		| element div { ltx.frontmatter.block.inner.acknowledgements & ltx.attrs.no-class & ltx.class.acknowledgements }
		)
	ltx.frontmatter.block.inner.keywords =
		( text,
		  element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.keywords }?,
		  ltx.Inline.model
		)
	ltx.frontmatter.block.inner.classification =
		( text,
		  element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.classification }?,
		  ltx.Inline.model
		)
	ltx.frontmatter.block.inner.acknowledgements =
		( text,
		  element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.acknowledgements }?,
		  ltx.Inline.model
		)

## CV Header: custom header grid used by the LaTeXML moderncv binding --
## a binding-introduced layout convention, not part of the core models
	ltx.cv.header.elem =
		element div { ltx.cv.header.inner & ltx.attrs.no-class & ltx.class.cv.header }
	ltx.cv.header.inner =
		( text,
		  ltx.cv.header.column.elem*,
		  text
		)
	ltx.cv.header.column.elem =
		element div { ltx.cv.header.column.inner & ltx.attrs.no-class & ltx.class.cv.column }
	ltx.cv.header.column.inner =
		( text,
		  ( ltx.cv.heading.elem
		  | ltx.heading.elem
		  | ltx.Para.class
		  | ltx.Block.class
		  | ltx.Inline.class
		  | ltx.Misc.inline.class
		  | ltx.Misc.block.class
		  | ltx.Meta.class
		  )*,
		  text
		)
	ltx.cv.heading.elem =
		( element h1 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		| element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.cv.heading }
		)

# ====================================================================
# Sectional Units: monotone descent, mirroring the LaTeXML sectional
# models (section.body.class etc.) -- each level admits Para.model plus
# any strictly deeper sectional unit, never same-or-shallower.

## Appendix: \code{appendix.body.class} = Para.model or any sectional level
	ltx.appendix.elem =
		element section { ltx.appendix.inner & ltx.attrs.no-class & ltx.class.appendix }
	ltx.appendix.inner =
		( text,
		  ltx.appendix.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.section.elem
		  | ltx.subsection.elem
		  | ltx.subsubsection.elem
		  | ltx.sectional.paragraph.elem
		  | ltx.subparagraph.elem
		  )*,
		  text
		)

## Chapter: \code{chapter.body.class} = Para.model or section and deeper.
## Book backmatter (bibliography, index) is hoisted into chapters by the
## book classes, so BackMatter is admitted here as well.
	ltx.chapter.elem =
		element section { ltx.chapter.inner & ltx.attrs.no-class & ltx.class.chapter }
	ltx.chapter.inner =
		( text,
		  ltx.chapter.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.section.elem
		  | ltx.subsection.elem
		  | ltx.subsubsection.elem
		  | ltx.sectional.paragraph.elem
		  | ltx.subparagraph.elem
		  | ltx.backmatter.elem
		  )*,
		  text
		)

## Section: \code{section.body.class} = Para.model or subsection and deeper
	ltx.section.elem =
		element section { ltx.section.inner & ltx.attrs.no-class & ltx.class.section }
	ltx.section.inner =
		( text,
		  ltx.section.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.subsection.elem
		  | ltx.subsubsection.elem
		  | ltx.sectional.paragraph.elem
		  | ltx.subparagraph.elem
		  )*,
		  text
		)

## Subsection
	ltx.subsection.elem =
		element section { ltx.subsection.inner & ltx.attrs.no-class & ltx.class.subsection }
	ltx.subsection.inner =
		( text,
		  ltx.subsection.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.subsubsection.elem
		  | ltx.sectional.paragraph.elem
		  | ltx.subparagraph.elem
		  )*,
		  text
		)

## Subsubsection
	ltx.subsubsection.elem =
		element section { ltx.subsubsection.inner & ltx.attrs.no-class & ltx.class.subsubsection }
	ltx.subsubsection.inner =
		( text,
		  ltx.subsubsection.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.sectional.paragraph.elem
		  | ltx.subparagraph.elem
		  )*,
		  text
		)

## Sectional Paragraph: the formal, possibly labelled LaTeX \cs{paragraph}
	ltx.sectional.paragraph.elem =
		element section { ltx.sectional.paragraph.inner & ltx.attrs.no-class & ltx.class.sectional.paragraph }
	ltx.sectional.paragraph.inner =
		( text,
		  ltx.sectional.paragraph.title.elem?,
		  text,
		  ( ltx.Para.class
		  | ltx.Meta.class
		  | ltx.subparagraph.elem
		  )*,
		  text
		)

## Subparagraph: subparagraph.body.class = Para.model
	ltx.subparagraph.elem =
		element section { ltx.subparagraph.inner & ltx.attrs.no-class & ltx.class.subparagraph }
	ltx.subparagraph.inner =
		( text,
		  ltx.subparagraph.title.elem?,
		  ltx.Para.model
		)

## Sectional Unit Titles: the transform assigns each unit type one
## document-global heading rank (\code{f:seclev-aux}): h1 is the document
## title, so every unit starts at h2, and each unit-type that can host
## the unit adds one rank, capped at h6.  With \code{ltx:part} outside
## the profile that yields: chapter h2; section h2-h3; subsection h2-h4;
## subsubsection h2-h5; paragraph and subparagraph h2-h6.
	ltx.chapter.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.chapter }
		)
	ltx.section.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.sectionkind }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.sectionkind }
		)
	ltx.subsection.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsection }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsection }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsection }
		)
	ltx.subsubsection.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsubsection }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsubsection }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsubsection }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subsubsection }
		)
	ltx.sectional.paragraph.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.paragraph }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.paragraph }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.paragraph }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.paragraph }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.paragraph }
		)
	ltx.subparagraph.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subparagraph }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subparagraph }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subparagraph }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subparagraph }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.subparagraph }
		)
## Appendices sit at chapter level (h2), or one deeper when the document
## also carries titled chapters (h3).
	ltx.appendix.title.elem =
		( element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.appendix }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.appendix }
		)

## Any-rank, any-kind heading: only for the moderncv header columns,
## where hoisted sectional headings carry no derivable rank or kind.
	ltx.heading.elem =
		( element h1 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		| element h2 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		| element h3 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		| element h4 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		| element h5 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		| element h6 { ltx.heading.inner & ltx.attrs.no-class & ltx.class.title.any }
		)
	ltx.heading.inner =
		( ltx.Inline.model )
